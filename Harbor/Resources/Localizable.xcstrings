    "Remove": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaldır"
          }
        }
      }
    },
    "Restart %@ to apply the change.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Değişikliğin geçerli olması için %@ uygulamasını yeniden başlat."
          }
        }
      }
    },
    "Restart Harbor to switch languages.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dili değiştirmek için Harbor’ı yeniden başlat."
          }
        }
      }
    },
    "Restart Now": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şimdi Yeniden Başlat"
          }
        }
      }
    },
    "Screen Recording": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekran Kaydı"
          }
        }
      }
    },
    "Settings": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayarlar"
          }
        }
      }
    },
    "Source Code": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaynak Kodu"
          }
        }
      }
    },
    "The app didn’t quit. Quit it and try again.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulama kapanmadı. Kapatıp tekrar dene."
          }
        }
      }
    },
    "The download contained a different app, so it wasn’t installed.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İndirilen dosyada başka bir uygulama vardı, bu yüzden kurulmadı."
          }
        }
      }
    },
    "The download couldn’t be unpacked.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İndirilen dosya açılamadı."
          }
        }
      }
    },
    "The download didn’t finish. Check your connection and try again.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İndirme tamamlanmadı. Bağlantını kontrol edip tekrar dene."
          }
        }
      }
    },
    "The download doesn’t match the catalog, so it wasn’t installed.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İndirilen dosya katalogla eşleşmiyor, bu yüzden kurulmadı."
          }
        }
      }
    },
    "This app can’t be installed from Harbor yet.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu uygulama henüz Harbor’dan kurulamıyor."
          }
        }
      }
    },
