    "Checked %@": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son denetim: %@"
          }
        }
      }
    },
    "Checking…": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Denetleniyor…"
          }
        }
      }
    },
    "Downloading %lld%%": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İndiriliyor %%%lld"
          }
        }
      }
    },
    "Free Mac apps that share one look and one place for their settings.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aynı görünümü ve ayarları için tek bir yeri paylaşan ücretsiz Mac uygulamaları."
          }
        }
      }
    },
    "Get on the Website ↗": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sitesinden İndir ↗"
          }
        }
      }
    },
