    },
    "%@ doesn’t share its settings with Harbor yet. Use Settings in its menu.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ayarlarını henüz Harbor ile paylaşmıyor. Uygulamanın menüsündeki Ayarlar’ı kullan."
          }
        }
      }
    },
    "%@, %@": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, %@"
          }
        }
      }
    },
    "%lld percent": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "yüzde %lld"
          }
        }
      }
    },
    "About": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hakkında"
          }
        }
      }
    },
