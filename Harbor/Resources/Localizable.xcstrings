      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Harbor"
          }
        }
      }
    },
    "Harbor %@ is available": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Harbor %@ çıktı"
          }
        }
      }
    },
    "Harbor can’t write to the app’s folder. Update it from its website instead.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Harbor uygulamanın klasörüne yazamıyor. Bunun yerine sitesinden güncelle."
          }
        }
      }
    },
