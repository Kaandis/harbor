      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulamalar"
          }
        }
      }
    },
    "Change these in System Settings › Privacy & Security.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bunları Sistem Ayarları › Gizlilik ve Güvenlik’ten değiştirebilirsin."
          }
        }
      }
    },
    "Check for Updates": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Güncellemeleri Denetle"
          }
        }
      }
