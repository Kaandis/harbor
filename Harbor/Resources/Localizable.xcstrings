      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulama Ekle…"
          }
        }
      }
    },
    "All Apps": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüm Uygulamalar"
          }
        }
      }
    },
